# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
# Builds: only the playable Windows build is versioned (see README); test builds stay local.
/[Bb]uilds/*
!/[Bb]uilds/Windows/
/[Bb]uilds/Windows/*_BurstDebugInformation_DoNotShip/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store Tools
/[Aa]ssets/AssetStoreTools*

# IDE and editor generated files
/.vs/
/.vscode/
/.idea/
*.csproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated metadata and crash files
/[Aa]ssets/_Recovery*
sysinfo.txt
*.pidb.meta
*.pdb.meta
*.mdb.meta
crashlytics-build.properties

# Build artifacts and packages
*.apk
*.aab
*.unitypackage
*.app

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Root folder metadata is not part of the Unity project
/.meta

# Unity Performance Testing run outputs (regenerated by the test runner)
/[Aa]ssets/[Rr]esources/PerformanceTestRun*
